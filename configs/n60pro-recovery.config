# Wired-only recovery; do not merge with n60pro.config.
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_netcore_n60-pro=y
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_filogic_DEVICE_netcore_n60-pro="-kmod-usb3 -automount -kmod-usb-ledtrig-usbport"
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS_SEPARATE=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_XZ=y
# CONFIG_TARGET_INITRAMFS_FORCE is not set
# CONFIG_TARGET_ROOTFS_SQUASHFS is not set
# CONFIG_TARGET_ROOTFS_EROFS is not set
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set
CONFIG_USE_APK=y
CONFIG_CCACHE=y
CONFIG_BUILD_LOG=y
CONFIG_INCLUDE_CONFIG=y
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y
# CONFIG_BUILDBOT is not set
# CONFIG_ALL is not set
# CONFIG_ALL_KMODS is not set
# CONFIG_ALL_NONSHARED is not set
# CONFIG_SDK is not set
# CONFIG_IB is not set
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_DEBUG_INFO_BTF is not set
# CONFIG_KERNEL_XDP_SOCKETS is not set

CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_fitblk=y
CONFIG_PACKAGE_fit-check-sign=y
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_fwtool=y
CONFIG_PACKAGE_logd=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_procd=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-leds-gpio=y

# The target still generates boot artifacts. Kconfig declares these symbols as
# bool, so '=m' is rejected by defconfig; select them with '=y' and rely on the
# manifest/rootfs checks to prove they are not installed in the ramdisk.
CONFIG_PACKAGE_u-boot-mt7986_netcore_n60-pro=y
CONFIG_PACKAGE_trusted-firmware-a-mt7986-spim-nand-ddr4=y

# Override the upstream router/tweak/device defaults explicitly.
# CONFIG_PACKAGE_apk-openssl is not set
# CONFIG_PACKAGE_autocore is not set
# CONFIG_PACKAGE_automount is not set
# CONFIG_PACKAGE_block-mount is not set
# CONFIG_PACKAGE_default-settings is not set
# CONFIG_PACKAGE_default-settings-chn is not set
# CONFIG_PACKAGE_dnsmasq-full is not set
# CONFIG_PACKAGE_firewall4 is not set
# CONFIG_PACKAGE_hnat-detect is not set
# CONFIG_PACKAGE_kmod-crypto-hw-safexcel is not set
# CONFIG_PACKAGE_kmod-nf-nathelper is not set
# CONFIG_PACKAGE_kmod-nft-offload is not set
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-ledtrig-usbport is not set
# CONFIG_PACKAGE_l1util is not set
# CONFIG_PACKAGE_luci is not set
# CONFIG_PACKAGE_mtk-smp is not set
# CONFIG_PACKAGE_nftables is not set
# CONFIG_PACKAGE_odhcp6c is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_ppp-mod-pppoe is not set
# CONFIG_PACKAGE_procd-ujail is not set
# CONFIG_PACKAGE_uboot-envtools is not set
# CONFIG_PACKAGE_wifi-scripts is not set
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_kmod-mt_wifi is not set
# CONFIG_PACKAGE_kmod-conninfra is not set
# CONFIG_PACKAGE_kmod-mediatek_hnat is not set
# CONFIG_PACKAGE_kmod-warp is not set
# CONFIG_PACKAGE_kmod-mt7915e is not set
# CONFIG_PACKAGE_kmod-mt76 is not set
# CONFIG_PACKAGE_kmod-mac80211 is not set
# CONFIG_PACKAGE_kmod-cfg80211 is not set
# CONFIG_PACKAGE_mtwifi-cfg-ucode is not set
# CONFIG_PACKAGE_wifi-dats is not set
# CONFIG_PACKAGE_wireless-regdb is not set
