config dnsmasq
	option port '0'
	option domainneeded '1'
	option boguspriv '1'
	option authoritative '1'
	option nonwildcard '1'
	option localservice '1'
	list interface 'lan'

config dhcp 'lan'
	option interface 'lan'
	option start '100'
	option limit '50'
	option leasetime '1h'
	list dhcp_option '3'
	list dhcp_option '6'
